{
  "name": "dfai-lite",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "e2e": "pnpm build && playwright test",
    "index": "node tools/build-index.ts",
    "tauri": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri",
    "rust:check": "cd src-tauri && export PATH=\"$HOME/.cargo/bin:$PATH\" && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "~2.12.5",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "@tauri-apps/plugin-global-shortcut": "~2.4.1",
    "codemirror": "^6.0.2",
    "d3-force": "^3.0.1",
    "dompurify": "^3.4.18",
    "markdown-it": "^15.0.3",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "~2.12.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/d3-force": "^3.0.10",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
